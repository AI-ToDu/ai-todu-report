flowchart TB
 subgraph inventory["CORE · Inventory"]
 direction LR
 warehouse["Almacenero<br/>WAREHOUSE"]:::actor --> movement["RecordMovementCommand"]:::command
 movement --> item["InventoryItem"]:::aggregate
 item -->|"Saldo previo > mínimo<br/>Saldo nuevo ≤ mínimo"| low["StockBelowMinimum"]:::event
 item -->|"Salida sin saldo suficiente"| stockError["409 INSUFFICIENT_STOCK<br/>Sin movimiento"]:::rejection
 end
 subgraph commercial["SOPORTE · Sales"]
 direction LR
 seller["Vendedor<br/>SALES"]:::actor --> confirm["ConfirmSaleCommand"]:::command
 confirm -->|"Stock descontado<br/>en la misma transacción"| sale["Sale"]:::aggregate
 sale --> confirmed["SaleConfirmed"]:::event
 confirm -->|"Una línea sin stock"| saleError["409 INSUFFICIENT_STOCK<br/>Rollback de la venta"]:::rejection
 end
 subgraph logistics["CORE · Logistics"]
 direction LR
 coordinator["Operador de logística<br/>LOGISTICS"]:::actor --> transition["TransitionDispatchCommand<br/>DELIVERED"]:::command
 transition --> manifest["DispatchManifest"]:::aggregate
 manifest -->|"En tránsito y con receptor"| delivery["DeliveryConfirmed"]:::event
 manifest -->|"No está en tránsito"| deliveryError["422 INVALID_TRANSITION<br/>Sin cambio de estado"]:::rejection
 end
 subgraph notifications["SOPORTE · Notifications"]
 direction LR
 message["Mensaje de integración v1<br/>Entregado por el relay"]:::integration
 message --> policy["Al recibir un aviso de stock mínimo,<br/>venta confirmada o entrega confirmada,<br/>registrar una notificación"]:::policy
 policy --> saved["Notification<br/>Una por eventId"]:::aggregate
 saved --> inbox["Bandeja de notificaciones<br/>GET /api/v1/notifications"]:::read
 reader["Usuario autenticado<br/>del workspace"]:::actor -->|"Consulta"| inbox
 end
