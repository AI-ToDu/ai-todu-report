erDiagram
  suppliers {
    uuid id
    uuid tenant_id
    string name
    string contact
  }
  purchase_orders {
    uuid id
    uuid tenant_id
    uuid supplier_id
    timestamp created_at
    bigint version
  }
  purchase_lines {
    uuid purchase_id
    integer line_order
    uuid id
    uuid product_id
    integer quantity
    integer received
  }
  customer_returns {
    uuid id
    uuid tenant_id
    uuid sale_id
    uuid sale_line_id
    uuid product_id
    integer quantity
    string disposition
    string reason
    timestamp created_at
    bigint loss_cents
  }
  purchase_orders ||--o{ purchase_lines : "FK"
  suppliers ||--o{ purchase_orders : "FK"
